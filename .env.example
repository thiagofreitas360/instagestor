# Ambiente local. Nunca reutilize os valores de exemplo em produção.
NODE_ENV=development

# PostgreSQL local (fora dos containers). O Compose troca localhost por postgres.
POSTGRES_DB=instagestor
POSTGRES_USER=instagestor
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://instagestor:local-postgres-password-change-me@localhost:5432/instagestor
DATABASE_POOL_SIZE=10

# Aplicação e sessão. Gere valores próprios com os scripts secret:*.
APP_URL=http://localhost:3000
WEB_PORT=3000
SESSION_SECRET=local-development-session-secret-change-before-production
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Admin criado por pnpm db:seed.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=local-admin-password-change-me

# Use fake até concluir a configuração humana da Meta.
INSTAGRAM_PROVIDER=fake
# O Compose executa `next start` com NODE_ENV=production; este opt-in é só local.
ALLOW_FAKE_PROVIDER_IN_PRODUCTION=true
FAKE_PROVIDER_SCENARIO=success

# Meta — substitua somente ao ativar INSTAGRAM_PROVIDER=meta.
META_API_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback
META_HTTP_TIMEOUT_MS=30000
CONTAINER_POLL_SECONDS=60
INSIGHTS_SYNC_INTERVAL_MS=3600000
INSIGHTS_MEDIA_WINDOW_DAYS=30

# MinIO/S3 compatível. Para pnpm dev, o endpoint publicado é localhost.
STORAGE_PROVIDER=s3
LOCAL_STORAGE_PATH=uploads
MINIO_ROOT_USER=instagestor
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=instagestor-media
S3_ACCESS_KEY_ID=instagestor
S3_SECRET_ACCESS_KEY=local-minio-password-change-me
S3_FORCE_PATH_STYLE=true
PUBLISHABLE_URL_TTL_SECONDS=7200

# Worker, leases e limites de concorrência.
WORKER_CONCURRENCY=3
MAX_PUBLICATION_ATTEMPTS=5
WORKER_POLL_MS=5000
JOB_LOCK_SECONDS=180
META_GLOBAL_CONCURRENCY=4
META_ACCOUNT_CONCURRENCY=1

# Regras locais.
DEFAULT_TIMEZONE=America/Sao_Paulo
UPLOAD_MAX_BYTES=300000000
