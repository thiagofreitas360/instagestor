{
  "manifest_version": 3,
  "name": "InstaGestor Downloader",
  "version": "1.0.2",
  "description": "Baixe reels, fotos, stories e destaques do Instagram em ZIP com a conta logada no seu navegador. Integra com o painel do InstaGestor.",
  "author": "InstaGestor",
  "homepage_url": "https://instagestor.orbih.shop",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://scontent*.cdninstagram.com/*",
    "https://scontent*.fbcdn.net/*",
    "https://instagestor.orbih.shop/*",
    "https://www.instagestor.orbih.shop/*",
    "https://redegestor.thautomacoes.shop/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://instagestor.orbih.shop/*",
      "https://www.instagestor.orbih.shop/*",
      "https://redegestor.thautomacoes.shop/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ig_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://instagestor.orbih.shop/*",
        "https://www.instagestor.orbih.shop/*",
        "https://redegestor.thautomacoes.shop/*",
        "http://localhost/*"
      ],
      "js": [
        "panel_relay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "libs/jszip.min.js"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ]
}
